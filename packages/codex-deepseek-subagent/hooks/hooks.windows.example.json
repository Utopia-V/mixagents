{
  "description": "Legacy one-shot plaintext handoff for v4_flash_worker on Codex 0.148.x and older.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^v4_flash_worker$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\\\ABSOLUTE\\\\PATH\\\\TO\\\\plaintext-handoff.ps1\" -Mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged Flash assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
