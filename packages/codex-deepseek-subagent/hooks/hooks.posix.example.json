{
  "description": "Legacy one-shot plaintext handoff for v4_flash_worker on Codex 0.148.x and older.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^v4_flash_worker$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/plaintext_handoff.py\" --mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged Flash assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
